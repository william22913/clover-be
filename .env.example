# Copy to .env and adjust for local use. No real secret belongs in this file.
DATABASE_URL=postgres://clover:clover@postgres:5432/clover?sslmode=disable
PUBLIC_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
MEDIA_DIR=./media
HTTP_ADDR=:8080
METRICS_ADDR=:9090
POSTGRES_USER=clover
POSTGRES_PASSWORD=clover
POSTGRES_DB=clover
# Comma-separated CIDRs whose X-Forwarded-For / X-Real-IP is believed (the
# frontend reverse proxy). Empty trusts no forwarding header, which is correct
# when the API is reached directly. With a proxy in front, set it to the
# proxy's address range or every sign-in shares one rate-limit bucket.
TRUSTED_PROXY_CIDRS=
# When unset, COOKIE_SECURE follows PUBLIC_ORIGIN: https means Secure cookies.
