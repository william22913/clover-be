# Copy to .env and adjust for local use. No real secret belongs in this file.
DATABASE_URL=postgres://clover:clover@postgres:5432/clover?sslmode=disable
PUBLIC_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
MEDIA_DIR=./media
HTTP_ADDR=:8080
METRICS_ADDR=:9090
POSTGRES_USER=clover
POSTGRES_PASSWORD=clover
POSTGRES_DB=clover
