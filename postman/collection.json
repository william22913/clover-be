    {
      "name": "Observability",
      "item": [
        {
          "name": "Metrics listener is scraped",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 text exposition', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('text/plain');",
                  "});",
                  "const body = pm.response.text();",
                  "pm.test('requests are labelled by route template and status', () => {",
                  "  pm.expect(body).to.include('clover_http_requests_total{');",
                  "  pm.expect(body).to.include('route=\"/v1/movies\"');",
                  "  pm.expect(body).to.include('clover_http_request_duration_seconds_bucket');",
                  "});",
                  "pm.test('error and business counters exist', () => {",
                  "  pm.expect(body).to.include('clover_http_errors_total{code=\"session_expired\"');",
                  "  pm.expect(body).to.include('clover_signins_total');",
                  "  pm.expect(body).to.include('clover_sessions_revoked_total');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{metricsBaseUrl}}/metrics",
              "host": ["{{metricsBaseUrl}}"],
              "path": ["metrics"]
            }
          }
        },
        {
          "name": "Public port does not expose metrics",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
