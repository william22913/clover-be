                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"nobody_here\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('code is AUTH_INVALID_CREDENTIALS', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.error.code).to.eql('AUTH_INVALID_CREDENTIALS');",
                  "  pm.expect(body.error.message).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.error.requestId).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
