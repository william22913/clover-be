{
  "info": {
    "name": "clover — FEAT-001 v1",
    "description": "Contract and smoke checks for the clover-be service. Cookie handling is automatic: the Auth folder signs up, exercises the session, then signs back in, so the Media folder streams with a live session. One folder per controller and one per FE screen.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Sign up (new account)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('signupEmail', 'viewer.' + Date.now() + '@example.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('account echoed', () => pm.expect(body.user.email).to.eql(pm.collectionVariables.get('signupEmail')));",
                  "pm.test('session cookie set', () => pm.expect(pm.response.headers.get('Set-Cookie') || '').to.include('clover_session='));",
                  "pm.test('cookie is HttpOnly and Secure', () => {",
                  "  const c = pm.response.headers.get('Set-Cookie') || '';",
                  "  pm.expect(c).to.include('HttpOnly');",
                  "  pm.expect(c).to.include('Secure');",
                  "  pm.expect(c).to.include('SameSite=Lax');",
                  "});",
                  "pm.collectionVariables.set('accountEmail', body.user.email);",
                  "pm.collectionVariables.set('accountPassword', pm.collectionVariables.get('signupPassword'));",
                  "// The cookie is Secure, and Newman only sends Secure cookies over TLS, so the",
                  "// session this collection presents is carried explicitly in a Cookie header.",
                  "const setCookie = pm.response.headers.get('Set-Cookie') || '';",
                  "const token = /clover_session=([^;,\\s]+)/.exec(setCookie);",
                  "pm.test('session token captured', () => pm.expect(token).to.not.be.null);",
                  "if (token) pm.collectionVariables.set('sessionToken', token[1]);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{signupEmail}}\",\n  \"password\": \"{{signupPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/sign-up",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "sign-up"]
            }
          }
        },
        {
          "name": "Me while signed in",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 ok', () => pm.response.to.have.status(200));",
                  "pm.test('same account', () => pm.expect(pm.response.json().user.email).to.eql(pm.collectionVariables.get('accountEmail')));",
                  "pm.test('request id header', () => pm.expect(pm.response.headers.get('X-Request-Id')).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Cookie", "value": "clover_session={{sessionToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "me"]
            }
          }
        },
        {
          "name": "Sign out",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('revokedToken', pm.collectionVariables.get('sessionToken'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 no content', () => pm.response.to.have.status(204));",
                  "pm.collectionVariables.set('sessionToken', '');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Cookie", "value": "clover_session={{revokedToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/sign-out",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "sign-out"]
            }
          }
        },
        {
          "name": "Me after sign-out is refused",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 session_expired', () => {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json().error.code).to.eql('session_expired');",
                  "});",
                  "pm.test('the revoked cookie is refused outright', () => pm.expect(pm.response.json().error.code).to.eql('session_expired'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Cookie", "value": "clover_session={{revokedToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "me"]
            }
          }
        },
        {
          "name": "Duplicate sign-up is refused",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 email_taken', () => {",
                  "  pm.response.to.have.status(409);",
                  "  pm.expect(pm.response.json().error.code).to.eql('email_taken');",
                  "});",
                  "pm.test('no session issued', () => pm.expect(pm.response.headers.get('Set-Cookie') || '').to.not.include('clover_session='));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{accountEmail}}\",\n  \"password\": \"Different123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/sign-up",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "sign-up"]
            }
          }
        },
        {
          "name": "Sign in with a wrong password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 invalid_credentials', () => {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json().error.code).to.eql('invalid_credentials');",
                  "});",
                  "pm.collectionVariables.set('genericMessage', pm.response.json().error.message);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{accountEmail}}\",\n  \"password\": \"NotThePassword1\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/sign-in",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "sign-in"]
            }
          }
        },
        {
          "name": "Unknown email gets the same message",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 invalid_credentials', () => {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json().error.code).to.eql('invalid_credentials');",
                  "});",
                  "pm.test('byte-identical message', () => pm.expect(pm.response.json().error.message).to.eql(pm.collectionVariables.get('genericMessage')));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nobody.{{$timestamp}}@example.com\",\n  \"password\": \"NotThePassword1\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/sign-in",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "sign-in"]
            }
          }
        },
        {
          "name": "Sign in with the created account",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 signed in', () => pm.response.to.have.status(200));",
                  "pm.test('new session cookie', () => pm.expect(pm.response.headers.get('Set-Cookie') || '').to.include('clover_session='));",
                  "const setCookie = pm.response.headers.get('Set-Cookie') || '';",
                  "const token = /clover_session=([^;,\\s]+)/.exec(setCookie);",
                  "if (token) pm.collectionVariables.set('sessionToken', token[1]);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{accountEmail}}\",\n  \"password\": \"{{accountPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/sign-in",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "sign-in"]
            }
          }
        },
        {
          "name": "OPTIONS preflight",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 with Allow', () => {",
                  "  pm.response.to.have.status(204);",
                  "  pm.expect(pm.response.headers.get('Allow')).to.include('POST');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "OPTIONS",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/sign-in",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "sign-in"]
            }
          }
        }
      ]
    },
    {
      "name": "Catalogue",
      "item": [
        {
          "name": "List every published movie",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 ok', () => pm.response.to.have.status(200));",
                  "const items = pm.response.json().items;",
                  "pm.test('13 seeded films', () => pm.expect(items.length).to.eql(13));",
                  "pm.test('catalogue order starts at halcyon', () => pm.expect(items[0].slug).to.eql('halcyon'));",
                  "pm.test('no internal id leaks', () => pm.expect(items[0]).to.not.have.property('id'));",
                  "pm.test('a card has poster, title and description', () => {",
                  "  pm.expect(items[0].poster_url).to.include('/media/poster/');",
                  "  pm.expect(items[0].title).to.be.a('string');",
                  "  pm.expect(items[0].short_description).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/movies",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "movies"]
            }
          }
        },
        {
          "name": "Get one movie",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 ok', () => pm.response.to.have.status(200));",
                  "pm.test('halcyon bay', () => pm.expect(pm.response.json().title).to.eql('Halcyon Bay'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/movies/{{slug}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "movies", "{{slug}}"]
            }
          }
        },
        {
          "name": "Unknown movie is movie_not_found",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 movie_not_found', () => {",
                  "  pm.response.to.have.status(404);",
                  "  pm.expect(pm.response.json().error.code).to.eql('movie_not_found');",
                  "});",
                  "pm.test('body request id matches the header', () => pm.expect(pm.response.json().error.request_id).to.eql(pm.response.headers.get('X-Request-Id')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/movies/not-in-the-catalogue",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "movies", "not-in-the-catalogue"]
            }
          }
        },
        {
          "name": "Wrong method is a JSON 405",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('405 with Allow', () => {",
                  "  pm.response.to.have.status(405);",
                  "  pm.expect(pm.response.headers.get('Allow')).to.include('GET');",
                  "  pm.expect(pm.response.json().error.code).to.eql('method_not_allowed');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/movies",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "movies"]
            }
          }
        },
        {
          "name": "OPTIONS preflight",
          "event": [
            {
              "listen": "test",
              "script": {
