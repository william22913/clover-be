    {
      "name": "Preflight",
      "item": [
        {
          "name": "Preflight: catalogue",
          "request": {
            "method": "OPTIONS",
            "header": [],
            "url": "{{baseUrl}}/v1/movies"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
