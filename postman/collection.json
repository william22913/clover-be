{
  "info": {
    "name": "Clover API",
    "description": "End-to-end checks for the Clover v1 API. Folders follow the controllers (Health, Catalogue, Auth, Media) plus one OPTIONS preflight per browser-called endpoint. Run against a seeded stack; the sign-in requests set and clear the session cookie like a browser.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "username",
      "value": "alex"
    },
    {
      "key": "password",
      "value": "Watch1234"
    },
    {
      "key": "filmId",
      "value": "amber-drift"
    },
    {
      "key": "otherFilmId",
      "value": "long-evening"
    },
    {
      "key": "longestFilmId",
      "value": "long-evening"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Liveness",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/healthz"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('body is ok', () => pm.expect(pm.response.text().trim()).to.eql('ok'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Readiness",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/readyz"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('body is ready', () => pm.expect(pm.response.text().trim()).to.eql('ready'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Metrics exposition",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{metricsUrl}}/metrics"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('prometheus text format', () => pm.expect(pm.response.headers.get('Content-Type'))",
                  "  .to.include('text/plain'));",
                  "pm.test('request counters are exposed', () => pm.expect(pm.response.text())",
                  "  .to.include('http_requests_total'));",
                  "pm.test('request duration histogram is exposed', () => pm.expect(pm.response.text())",
                  "  .to.include('http_request_duration_seconds'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Catalogue",
      "item": [
        {
          "name": "List the catalogue (anonymous)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/v1/movies"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('twenty films', () => pm.expect(body.movies).to.have.lengthOf(20));",
                  "pm.test('every film carries its fields', () => {",
                  "  body.movies.forEach((m) => {",
                  "    pm.expect(m.id).to.be.a('string').and.not.empty;",
                  "    pm.expect(m.title).to.be.a('string').and.not.empty;",
                  "    pm.expect(m.description).to.be.a('string').and.not.empty;",
                  "    pm.expect(m.posterUrl).to.eql('/v1/media/movies/' + m.id + '/poster');",
                  "    pm.expect(m.videoUrl).to.eql('/v1/media/movies/' + m.id + '/video');",
                  "    pm.expect(m.durationSeconds).to.be.within(1, 1800);",
                  "  });",
                  "});",
                  "pm.test('editorial order', () => {",
                  "  body.movies.forEach((m, i) => pm.expect(m.position).to.eql(i + 1));",
                  "});",
                  "pm.collectionVariables.set('filmId', body.movies[0].id);",
                  "pm.collectionVariables.set('otherFilmId', body.movies[2].id);",
                  "pm.collectionVariables.set('longestFilmId', 'long-evening');"
                ]
              }
            }
          ]
        },
        {
          "name": "One film",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/v1/movies/{{filmId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const m = pm.response.json().movie;",
                  "pm.test('same film', () => pm.expect(m.id).to.eql(pm.collectionVariables.get('filmId')));",
                  "pm.test('title and description', () => {",
                  "  pm.expect(m.title).to.be.a('string').and.not.empty;",
                  "  pm.expect(m.description).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown film is a clean 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/v1/movies/does-not-exist"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 404', () => pm.response.to.have.status(404));",
                  "pm.test('code is MOVIE_NOT_FOUND', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.error.code).to.eql('MOVIE_NOT_FOUND');",
                  "  pm.expect(body.error.message).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.error.requestId).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "English whatever Accept-Language says",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept-Language",
                "value": "fr-FR"
              }
            ],
            "url": "{{baseUrl}}/v1/movies"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('English titles', () => {",
                  "  const titles = pm.response.json().movies.map((m) => m.title);",
                  "  pm.expect(titles).to.include('Amber Drift');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Wrong password is one generic refusal",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{username}}\",\n  \"password\": \"Wrong1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('code is AUTH_INVALID_CREDENTIALS', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.error.code).to.eql('AUTH_INVALID_CREDENTIALS');",
                  "  pm.expect(body.error.message).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.error.requestId).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.test('no field detail', () => pm.expect(pm.response.json().error.fields).to.be.undefined);"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown account is the same refusal",
          "request": {
            "method": "POST",
            "header": [
              {
