    {
      "name": "Media",
      "item": [
        {
          "name": "Stream the film",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 video', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('video/mp4');",
                  "  pm.expect(pm.response.headers.get('Accept-Ranges')).to.eql('bytes');",
                  "  pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Cookie", "value": "clover_session={{sessionToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/v1/movies/{{slug}}/video",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "movies", "{{slug}}", "video"]
            }
          }
        },
        {
          "name": "Byte range returns 206",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('206 partial content', () => {",
                  "  pm.response.to.have.status(206);",
                  "  pm.expect(pm.response.headers.get('Content-Range')).to.include('bytes 0-1023/');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Cookie", "value": "clover_session={{sessionToken}}" },
              { "key": "Range", "value": "bytes=0-1023" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/movies/{{slug}}/video",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "movies", "{{slug}}", "video"]
            }
          }
        },
        {
          "name": "Poster is public",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 image', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('image/jpeg');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/media/poster/p-{{slug}}.jpg",
              "host": ["{{baseUrl}}"],
              "path": ["media", "poster", "p-{{slug}}.jpg"]
            }
          }
        }
      ]
    },
